{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live Annotation Prompt v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "live-annotation/v1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "intent": {
      "const": "user_prompt"
    },
    "transcript": {
      "type": "string",
      "maxLength": 40000
    },
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "image"
              },
              "annotationId": {
                "type": "string",
                "format": "uuid"
              },
              "label": {
                "type": "string"
              },
              "attachmentId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "annotationId",
              "label",
              "attachmentId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "quote"
              },
              "annotationId": {
                "type": "string",
                "format": "uuid"
              },
              "label": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "annotationId",
              "label",
              "text"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "const": "image"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "rectangle",
                  "laser",
                  "upload"
                ]
              },
              "capturedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "attachmentId": {
                "type": "string",
                "format": "uuid"
              },
              "context": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "viewport": {
                    "type": "object",
                    "properties": {
                      "width": {
                        "type": "number"
                      },
                      "height": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  "scroll": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "url",
                  "title",
                  "viewport",
                  "scroll"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "kind",
              "capturedAt",
              "attachmentId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "const": "quote"
              },
              "label": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "typed",
                  "paste"
                ]
              },
              "capturedAt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "text",
              "source",
              "capturedAt"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "mediaType": {
            "const": "image/png"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "byteLength": {
            "type": "integer",
            "minimum": 33,
            "maximum": 8388608
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "pattern": "^attachments/Image [1-9][0-9]*\\.png$"
          }
        },
        "required": [
          "id",
          "label",
          "filename",
          "mediaType",
          "width",
          "height",
          "byteLength",
          "sha256",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "url",
        "conversationId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "intent",
    "transcript",
    "content",
    "annotations",
    "attachments"
  ],
  "additionalProperties": false
}
